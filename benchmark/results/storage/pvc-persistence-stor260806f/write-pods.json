_temporary, manifest)\ndirectory_fd = os.open(target, os.O_RDONLY | os.O_DIRECTORY)\ntry:\n    os.fsync(directory_fd)\nfinally:\n    os.close(directory_fd)\nprint(\"PVC_CHECKPOINT_WRITE_JSON=\" + json.dumps(record, sort_keys=True), flush=True)\n\nPY\n"
